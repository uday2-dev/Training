<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


<bean id = "customer" class = "com.coforge.beans.Customer">

<constructor-arg name = "cname" value = "uday"></constructor-arg>
<constructor-arg name = "cid" value = "678"></constructor-arg>
<constructor-arg name = "address" ref = "add"></constructor-arg>
<constructor-arg name = "mobile" value = "6306311274"></constructor-arg>
<constructor-arg name = "email" value = "uday@gmail.com"></constructor-arg>

</bean>

<bean id = "add"  class = "com.coforge.beans.Address">

<constructor-arg name ="houseno" value = "407"></constructor-arg>
<constructor-arg name ="street" value = "landmark"></constructor-arg>
<constructor-arg name ="city" value = "HYD"></constructor-arg>
<constructor-arg name ="state" value = "Telangana"></constructor-arg>
<constructor-arg name ="pincode" value = "208020"></constructor-arg>

</bean>



</beans>